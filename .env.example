# Copy to .env and replace the placeholders. Never commit real credentials.

# AI generation (optional unless using AI workflows or image generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional OTLP/HTTP ingestion. Run the Go service in ingest/ and point the app at it.
# The app adds /v1/metrics and /v1/traces. Keep Grafana credentials on the Go server.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=X-SlideFarm-Ingest-Key=your-ingest-key
# OTEL_SERVICE_NAME=slidefarm

# TikTok sandbox: enable Login Kit and Content Posting API with video.publish.
# For uploads to the TikTok inbox, enable video.upload and reconnect the account.
# Register the exact callback URL in TikTok. Web uses a public HTTPS callback;
# Desktop may use http://localhost:3000/api/tiktok/callback with PKCE.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-app-domain.example/api/tiktok/callback

# Cloudflare R2: use an API token with object write access to this bucket.
# The public HTTPS origin must be attached to the bucket and verified in TikTok.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TIKTOK_VERIFIED_URL_PREFIX=https://slides.example.com

# Optional: override the local directory for projects and connected account tokens.
# SLIDEFARM_DATA_DIR=

# Pinterest import: use an API from RapidAPI that supports search and board URLs.
# Paths are the provider endpoint paths. Search receives ?query= and board receives ?url=.
RAPIDAPI_KEY=
RAPIDAPI_PINTEREST_HOST=
RAPIDAPI_PINTEREST_SEARCH_PATH=
RAPIDAPI_PINTEREST_BOARD_PATH=
